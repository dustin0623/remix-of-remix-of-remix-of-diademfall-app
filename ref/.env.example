# =============================================================================
# Chainframe — environment variables
# =============================================================================
# Reference list of every value the app reads at runtime.
#
# On Lovable Cloud these do NOT live in a committed .env file: they are stored in
# Project Settings -> Secrets and injected into server code at runtime. Copy the
# names below into that form. Everything in this file is a placeholder showing
# the expected shape — none of it is a usable credential.
#
# Naming rule:
#   process.env.X   -> server-only, never shipped to the browser
#   import.meta.env.VITE_X -> public, readable by anyone who opens the site.
#                             Never put a secret behind a VITE_ name.

# -----------------------------------------------------------------------------
# 1. On-chain wallets + game token  (server-only)
# -----------------------------------------------------------------------------
# TREASURY_ADDRESS / TREASURY_KEY
#   The treasury wallet. This is the account players deposit into and the
#   account withdrawals are paid out from.
#   ADDRESS: XRPL account address (starts with "r") / equivalent on other chains.
#   KEY:     the active (or owner) key that signs payouts. Server-only.
TREASURY_ADDRESS=rExampleTreasuryAddress1234567890abcdef
TREASURY_KEY=<treasury active key>

# TOKEN_HEX
#   The game token, as an XRPL issued-currency code: 40 hex characters (160 bits).
#   A 3-letter symbol is its ASCII bytes zero-padded to 40 chars; a longer symbol
#   must be the full padded hex. The issuing account is stored alongside it and
#   both are needed to recognise a payment as "our token".
#   "HASH" -> 4841534800000000000000000000000000000000
TOKEN_HEX=4841534800000000000000000000000000000000

# MARKETPLACE_ADDRESS / MARKETPLACE_KEY
#   The marketplace wallet. Hero purchase payments land here; the seller's share
#   is forwarded from this account. Kept separate from the treasury so deposit /
#   withdrawal flow and marketplace flow never share one signing account.
MARKETPLACE_ADDRESS=rExampleMarketplaceAddress1234567890abcdef
MARKETPLACE_KEY=<marketplace active key>

# -----------------------------------------------------------------------------
# 2. Sign-in
# -----------------------------------------------------------------------------
# AUTH_CHALLENGE_SECRET
#   Signs the wallet sign-in challenge so a signature can't be replayed.
#   Any long random string (32+ chars). Generate once, then keep it stable —
#   changing it invalidates outstanding challenges.
AUTH_CHALLENGE_SECRET=<32+ random chars>

# API_KEY / API_SECRET
#   Xaman (XRPL wallet) developer console credentials, used for the XRPL sign-in
#   flow. From apps.xumm.dev. Server-only.
API_KEY=<xaman api key>
API_SECRET=<xaman api secret>

# -----------------------------------------------------------------------------
# 3. Backend (managed by Lovable Cloud — already present in .env)
# -----------------------------------------------------------------------------
# Set automatically for this project; listed here so nothing looks missing.
SUPABASE_URL=https://<project-ref>.lovable.cloud
SUPABASE_PUBLISHABLE_KEY=<publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
VITE_SUPABASE_URL=https://<project-ref>.lovable.cloud
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# LOVABLE_DB_MIGRATION_URL
#   Migration connection string used by the database tooling.
LOVABLE_DB_MIGRATION_URL=<direct database connection string>

# -----------------------------------------------------------------------------
# 4. Scheduled jobs (cron)
# -----------------------------------------------------------------------------
# LOVABLE_CRON_SECRET
#   Bearer token the scheduler sends to the cron endpoints. Rotating it keeps
#   the old value in LOVABLE_CRON_SECRET_PREVIOUS so in-flight jobs still pass.
LOVABLE_CRON_SECRET=<cron bearer token>
LOVABLE_CRON_SECRET_PREVIOUS=<previous cron bearer token, or empty>

# -----------------------------------------------------------------------------
# 5. Other chains (only used if the app's active chain changes)
# -----------------------------------------------------------------------------
# The app currently signs in with XRPL (src/lib/config/config.ts). These are the
# names the Hive and Solana modules look up; leave them unset while XRPL is active.
# HIVE_RPC_ENDPOINT, HIVE_TREASURY_ACCOUNT, HIVE_TREASURY_ACTIVE_KEY
# SOLANA_RPC_ENDPOINT, SOLANA_PRIVATE_NODE_API_KEY
# SOLANA_TREASURY_ADDRESS, SOLANA_TREASURY_SECRET_KEY
# VITE_REOWN_PROJECT_ID  (WalletConnect project id — public)
